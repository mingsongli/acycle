{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acycle:coco-publication-report-manifest:1.0",
  "title": "COCO publication validation report manifest",
  "description": "Portable input contract for build_coco_publication_reports.py. Relative case paths are resolved first against case_dir and then against the result root.",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "report_title": {"type": "string"},
    "title": {"type": "string"},
    "report_subtitle": {"type": "string"},
    "generated_at": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "status": {"type": "string"},
    "git_commit": {"type": "string"},
    "matlab_version": {"type": "string"},
    "acycle_version": {"type": "string"},
    "software": {
      "oneOf": [
        {"type": "string"},
        {"type": "object", "additionalProperties": true}
      ]
    },
    "methods": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"$ref": "#/$defs/method"}
            ]
          }
        },
        {"type": "object", "additionalProperties": {"type": "string"}}
      ]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "role": {"type": "string"}
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "case_dir": {"type": "string"},
        "case_manifest": {"type": "string"},
        "input_file": {"type": "string"},
        "input_sha256": {"type": "string"},
        "design_role": {"type": "string"},
        "kind": {"type": "string"},
        "age_ma": {"type": "number"},
        "expected_rate_cm_per_kyr": {
          "oneOf": [
            {"type": "number"},
            {"type": "string"},
            {"type": "array", "items": {"type": "number"}}
          ]
        },
        "expected_rate": {
          "oneOf": [
            {"type": "number"},
            {"type": "string"},
            {"type": "array", "items": {"type": "number"}}
          ]
        },
        "parameters_csv": {"type": "string"},
        "summary_csv": {"type": "string"},
        "conclusion_txt": {"type": "string"},
        "notes": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "figures": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"$ref": "#/$defs/figure"}
            ]
          }
        },
        "methods": {
          "type": "array",
          "items": {"$ref": "#/$defs/method"}
        }
      },
      "additionalProperties": true
    },
    "figure": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "caption": {"type": "string"},
        "method": {"type": "string"},
        "width": {
          "enum": ["full", "half", "full-column", "half-column", "180mm", "88mm"]
        },
        "order": {"type": "number"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
